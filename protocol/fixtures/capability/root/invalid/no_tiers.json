{
  "id": "triage.audio",
  "description": "音频预检：VAD 定界 + 段级粗类别打标 + 语音段 ASR，产出带时间轴的 digest。",
  "tiers": [],
  "input": {
    "media": {
      "presence": "required",
      "accepts": [
        "audio/*",
        "video/*"
      ],
      "preprocessor": "audio.to_wav_16k_mono"
    },
    "params_schema": {
      "type": "object",
      "properties": {
        "label_confidence_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.3
        },
        "language": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "purpose": "triage",
  "output": {
    "schema": "urn:mmp:protocol:2:digest",
    "agent_context": "required"
  }
}
