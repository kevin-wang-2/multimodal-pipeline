{
  "protocol_version": "3.0",
  "capabilities": [
    {
      "capability": {
        "id": "triage.audio",
        "description": "音频预检：VAD 定界 + 段级粗类别打标 + 语音段 ASR，产出带时间轴的 digest。",
        "tiers": [
          {
            "tier": "cpu",
            "engine": "silero-vad+sensevoice-int8+zipformer-tagging-int8",
            "engine_version": "m0-2026-09-10",
            "cost": "low",
            "latency_hint": "~0.05× 实时",
            "max_concurrency": 2
          }
        ],
        "input": { "fields": [
          { "name": "media", "kind": "media", "required": true,
            "accepts": ["audio/*", "video/*"], "cardinality": { "min": 1, "max": 1 },
            "preprocessor": "audio.to_wav_16k_mono" },
          { "name": "options", "kind": "json", "required": false, "schema": {
            "type": "object",
            "properties": {
              "label_confidence_threshold": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 0.3
              },
              "language": {
                "type": "string"
              }
            },
            "additionalProperties": false
          } }
        ] },
        "purpose": "triage",
        "output": { "fields": [
          { "name": "digest", "kind": "json", "required": true, "schema": "urn:mmp:protocol:3:digest" }
        ], "agent_context": "required" },
        "visibility": "public"
      },
      "nodes": [
        "mac-m1",
        "gpu-box"
      ]
    },
    {
      "capability": {
        "id": "ocr.structured",
        "description": "文档 OCR：快档出文本行，慢档出版面结构（Markdown + 元素标签）。",
        "tiers": [
          {
            "tier": "gpu-fast",
            "engine": "pp-ocrv6",
            "engine_version": "paddleocr-3.7",
            "cost": "low",
            "latency_hint": "~0.5s/page",
            "vram_mb": 2048,
            "max_concurrency": 2
          },
          {
            "tier": "gpu",
            "engine": "paddleocr-vl",
            "engine_version": "1.6-0.9b",
            "cost": "high",
            "latency_hint": "~9s/page",
            "vram_mb": 12288,
            "max_concurrency": 1
          }
        ],
        "input": { "fields": [
          { "name": "media", "kind": "media", "required": true,
            "accepts": ["image/*", "application/pdf"], "cardinality": { "min": 1, "max": 1 } },
          { "name": "options", "kind": "json", "required": false, "schema": {
            "type": "object",
            "properties": {
              "pages": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          } }
        ] },
        "purpose": "ocr",
        "output": { "fields": [
          { "name": "document", "kind": "json", "required": true, "schema": {
            "type": "object",
            "properties": {
              "pages": {
                "type": "array"
              }
            },
            "required": [
              "pages"
            ]
          } }
        ], "agent_context": "none" },
        "visibility": "public"
      },
      "nodes": [
        "gpu-box"
      ]
    }
  ]
}
