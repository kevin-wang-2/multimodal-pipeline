{
  "name": "@mmp/protocol",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "协议 schema 的加载、ajv 校验器与生成的 TypeScript 类型。唯一源头是仓库根的 protocol/schemas。",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "gen-types": "tsx scripts/gen-types.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "json-schema-to-typescript": "^15.0.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
