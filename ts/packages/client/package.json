{
  "name": "@mmp/client",
  "version": "0.2.2",
  "type": "module",
  "description": "multimodal-pipeline 的通用调用节点（C）客户端：任务传输、按 purpose + Content-Type 发现能力、透传 agent context。",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://mmp.seanartech.com/npm/",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kevin-wang-2/multimodal-pipeline",
    "directory": "ts/packages/client"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@mmp/protocol": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
