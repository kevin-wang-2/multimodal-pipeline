{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mmp:protocol:3:job-api",
  "title": "JobApi",
  "description": "C→B 任务 API（架构.md §5）。只有一种调用形态：提交即返回 job_id，可选 wait 秒长轮询。本文件没有根 schema，只有 $defs：每个端点的请求体 / 响应体各一个定义。人读版见 docs/协议.md。",
  "$defs": {
    "NodeId": {
      "description": "A 节点 id，由部署配置指定。小写字母、数字、连字符。",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "JobId": {
      "description": "由 A 生成：<node_id>-<ULID>。B 不生成 id，靠前缀把 GET / DELETE 路由回原节点。",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "Priority": {
      "type": "string",
      "enum": [
        "interactive",
        "batch"
      ]
    },
    "JobStatus": {
      "description": "queued → running → done | failed | cancelled；queued → cancelled。",
      "type": "string",
      "enum": [
        "queued",
        "running",
        "done",
        "failed",
        "cancelled"
      ]
    },
    "ErrorCode": {
      "description": "错误码表；HTTP 状态一一对应，见 docs/协议.md。",
      "type": "string",
      "enum": [
        "bad_request",
        "unsupported_type",
        "unauthorized",
        "not_found",
        "media_too_large",
        "media_fetch_failed",
        "media_not_found",
        "media_hash_mismatch",
        "backpressure",
        "engine_failed",
        "no_node",
        "node_offline",
        "timeout"
      ]
    },
    "Wait": {
      "description": "最长阻塞秒数。B 侧在途超时 = wait + 5s。",
      "type": "integer",
      "minimum": 0,
      "maximum": 120,
      "default": 0
    },
    "JobRequest": {
      "description": "POST /jobs 请求体。",
      "type": "object",
      "properties": {
        "type": {
          "$ref": "urn:mmp:protocol:3:capability#/$defs/TaskTypeId"
        },
        "arguments": {
          "description": "按 capability.input.fields 的 name 提交命名输入；A 按字段 kind/schema/MIME/cardinality 校验。",
          "type": "object",
          "minProperties": 1
        },
        "delivery": {
          "description": "media output 字段名到受控 PUT endpoint（或与多值输出等长的 endpoint 数组）的映射；没有 endpoint 时只能在内联上限内返回。",
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "$ref": "urn:mmp:protocol:3:media-handle#/$defs/Endpoint" },
              { "type": "array", "items": { "$ref": "urn:mmp:protocol:3:media-handle#/$defs/Endpoint" }, "minItems": 1 }
            ]
          }
        },
        "priority": {
          "$ref": "#/$defs/Priority",
          "default": "interactive"
        },
        "tier": {
          "description": "档位偏好。省略 = 该类型的默认档；A 若无法满足可回落并在 source.degraded 标注。",
          "$ref": "urn:mmp:protocol:3:capability#/$defs/Tier"
        },
        "wait": {
          "$ref": "#/$defs/Wait"
        }
      },
      "required": [
        "type",
        "arguments"
      ],
      "additionalProperties": false
    },
    "Source": {
      "description": "结果的来源标注（铁律 5）。描述的是产物本身：哪个引擎、哪一档、何时、是否降级。\"是否命中缓存\"属于本次交付而非产物，放在 JobDone.cached。",
      "type": "object",
      "properties": {
        "tier": {
          "$ref": "urn:mmp:protocol:3:capability#/$defs/Tier"
        },
        "engine": {
          "type": "string",
          "minLength": 1
        },
        "engine_version": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "degraded": {
          "description": "true = 未按请求的档位 / 完整流程产出（超时回落、部分工具失败等）。降级必须显式。",
          "type": "boolean"
        },
        "degraded_reason": {
          "type": "string",
          "enum": [
            "timeout",
            "tier_unavailable",
            "partial_failure"
          ]
        },
        "arguments": {
          "description": "实际生效的非媒体命名输入；媒体句柄、URL 与凭据不进入来源信息。",
          "type": "object"
        }
      },
      "required": [
        "tier",
        "engine",
        "engine_version",
        "generated_at",
        "degraded"
      ],
      "if": {
        "properties": {
          "degraded": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "degraded_reason"
        ]
      },
      "additionalProperties": false
    },
    "MediaIds": {
      "description": "按输入字段名回显已解析的媒体标识；下载尚未完成的字段暂不出现，准备阶段可以为空对象。",
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "$ref": "urn:mmp:protocol:3:media-handle#/$defs/MediaId" },
          { "type": "array", "items": { "$ref": "urn:mmp:protocol:3:media-handle#/$defs/MediaId" }, "minItems": 1 }
        ]
      }
    },
    "TextOutput": {
      "type": "object",
      "properties": { "kind": { "const": "text" }, "text": { "type": "string" } },
      "required": ["kind", "text"],
      "additionalProperties": false
    },
    "JsonOutput": {
      "type": "object",
      "properties": { "kind": { "const": "json" }, "value": {} },
      "required": ["kind", "value"],
      "additionalProperties": false
    },
    "MediaOutput": {
      "type": "object",
      "properties": {
        "kind": { "const": "media" },
        "content_type": { "type": "string", "pattern": "^[a-z0-9!#$&^_.+-]+/[a-zA-Z0-9!#$&^_.+-]+$" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "media_id": { "$ref": "urn:mmp:protocol:3:media-handle#/$defs/MediaId" },
        "inline": { "type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$" },
        "delivered": { "const": true }
      },
      "required": ["kind", "content_type", "bytes", "sha256", "media_id"],
      "oneOf": [
        { "required": ["inline"], "not": { "required": ["delivered"] } },
        { "required": ["delivered"], "not": { "required": ["inline"] } }
      ],
      "additionalProperties": false
    },
    "OutputAtom": {
      "oneOf": [
        { "$ref": "#/$defs/TextOutput" },
        { "$ref": "#/$defs/JsonOutput" },
        { "$ref": "#/$defs/MediaOutput" }
      ]
    },
    "OutputValue": {
      "oneOf": [
        { "$ref": "#/$defs/OutputAtom" },
        { "type": "array", "items": { "$ref": "#/$defs/MediaOutput" }, "minItems": 1 }
      ]
    },
    "AgentContext": {
      "description": "由任务实现确定性生成、可直接交给基础模型的上下文；客户端只透传，不解析其中的模态语义。",
      "type": "object",
      "properties": {
        "format": { "const": "mmp-agent-context-v1" },
        "content_type": { "const": "text/plain; charset=utf-8" },
        "text": { "type": "string", "minLength": 1 }
      },
      "required": ["format", "content_type", "text"],
      "additionalProperties": false
    },
    "Usage": {
      "description": "本次交付的引擎算力审计口径。只计算 run 消息发出到 result 收到的引擎执行时间，不含排队、模型加载、媒体取放与结果 PUT。",
      "type": "object",
      "properties": {
        "served_from": {
          "type": "string",
          "enum": ["compute", "cache"]
        },
        "tier": {
          "$ref": "urn:mmp:protocol:3:capability#/$defs/Tier"
        },
        "engine": {
          "type": "string",
          "minLength": 1
        },
        "compute_ms": {
          "description": "最终成功尝试占用引擎的毫秒数；缓存命中固定为 0。",
          "type": "integer",
          "minimum": 0
        },
        "wasted_ms": {
          "description": "最终成功前因超时回落或质量升级而废弃的引擎执行毫秒数；缓存命中固定为 0。",
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["served_from", "tier", "engine", "compute_ms", "wasted_ms"],
      "allOf": [
        {
          "if": { "properties": { "served_from": { "const": "cache" } }, "required": ["served_from"] },
          "then": {
            "properties": {
              "compute_ms": { "const": 0 },
              "wasted_ms": { "const": 0 }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "JobDone": {
      "description": "200：任务完成。outputs 的字段名与 capability.output.fields 一致。",
      "type": "object",
      "properties": {
        "job_id": {
          "$ref": "#/$defs/JobId"
        },
        "type": {
          "$ref": "urn:mmp:protocol:3:capability#/$defs/TaskTypeId"
        },
        "status": {
          "const": "done"
        },
        "media_ids": {
          "$ref": "#/$defs/MediaIds"
        },
        "cached": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "outputs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/OutputValue" }
        },
        "agent_context": {
          "$ref": "#/$defs/AgentContext"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "timings_ms": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [
        "job_id",
        "type",
        "status",
        "media_ids",
        "cached",
        "source",
        "outputs"
      ],
      "additionalProperties": false
    },
    "JobPending": {
      "description": "202：排队中（含媒体准备）或运行中；媒体准备也计入请求 wait 上限。",
      "type": "object",
      "properties": {
        "job_id": {
          "$ref": "#/$defs/JobId"
        },
        "type": {
          "$ref": "urn:mmp:protocol:3:capability#/$defs/TaskTypeId"
        },
        "media_ids": {
          "$ref": "#/$defs/MediaIds"
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "running"
          ]
        },
        "eta_sec": {
          "type": "number",
          "minimum": 0
        },
        "queue_position": {
          "type": "integer",
          "minimum": 0
        },
        "cancel_requested": {
          "description": "DELETE 已收到但任务在运行中，A 尽力而为；后续 GET 会得到 cancelled 或 done。",
          "type": "boolean"
        }
      },
      "required": [
        "job_id",
        "type",
        "media_ids",
        "status"
      ],
      "additionalProperties": false
    },
    "JobFailed": {
      "description": "任务已入队但最终失败；HTTP 状态按 error 对应。",
      "type": "object",
      "properties": {
        "job_id": {
          "$ref": "#/$defs/JobId"
        },
        "type": {
          "$ref": "urn:mmp:protocol:3:capability#/$defs/TaskTypeId"
        },
        "media_ids": {
          "$ref": "#/$defs/MediaIds"
        },
        "status": {
          "const": "failed"
        },
        "error": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        },
        "retry_after_sec": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "job_id",
        "type",
        "media_ids",
        "status",
        "error"
      ],
      "additionalProperties": false
    },
    "JobCancelled": {
      "description": "200：任务已取消。",
      "type": "object",
      "properties": {
        "job_id": {
          "$ref": "#/$defs/JobId"
        },
        "type": {
          "$ref": "urn:mmp:protocol:3:capability#/$defs/TaskTypeId"
        },
        "media_ids": {
          "$ref": "#/$defs/MediaIds"
        },
        "status": {
          "const": "cancelled"
        }
      },
      "required": [
        "job_id",
        "type",
        "media_ids",
        "status"
      ],
      "additionalProperties": false
    },
    "JobResponse": {
      "description": "POST /jobs、GET /jobs/{id}、DELETE /jobs/{id} 的任务态响应体。",
      "oneOf": [
        {
          "$ref": "#/$defs/JobDone"
        },
        {
          "$ref": "#/$defs/JobPending"
        },
        {
          "$ref": "#/$defs/JobFailed"
        },
        {
          "$ref": "#/$defs/JobCancelled"
        }
      ]
    },
    "ErrorBody": {
      "description": "没有 job_id 的错误（请求没被接受或找不到任务）。有 job_id 的失败用 JobFailed。",
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        },
        "retry_after_sec": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "AnyResponse": {
      "description": "任务端点可能返回的任何响应体。",
      "oneOf": [
        {
          "$ref": "#/$defs/JobResponse"
        },
        {
          "$ref": "#/$defs/ErrorBody"
        }
      ]
    },
    "CapabilitiesResponse": {
      "description": "GET /capabilities：B 把当前已连接 A 的注册表按任务类型合并。B 无状态，这只是此刻的视图。",
      "type": "object",
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "capability": {
                "$ref": "urn:mmp:protocol:3:capability"
              },
              "nodes": {
                "description": "提供该任务类型的节点。",
                "type": "array",
                "items": {
                  "$ref": "#/$defs/NodeId"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "capability",
              "nodes"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "protocol_version",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "HealthResponse": {
      "description": "GET /health：已连接 A 及其最近心跳摘要。",
      "type": "object",
      "properties": {
        "status": {
          "description": "ok = 至少一个节点在线；no_node = 没有节点。",
          "type": "string",
          "enum": [
            "ok",
            "no_node"
          ]
        },
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "node_id": {
                "$ref": "#/$defs/NodeId"
              },
              "connected_since": {
                "type": "string",
                "format": "date-time"
              },
              "last_heartbeat": {
                "type": "string",
                "format": "date-time"
              },
              "heartbeat": {
                "$ref": "urn:mmp:protocol:3:ab-message#/$defs/HeartbeatPayload"
              }
            },
            "required": [
              "node_id",
              "connected_since",
              "last_heartbeat"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "protocol_version",
        "nodes"
      ],
      "additionalProperties": false
    },
    "ProtocolVersion": {
      "description": "major.minor。major 不同即不兼容；minor 只做向后兼容的追加。",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    }
  }
}
