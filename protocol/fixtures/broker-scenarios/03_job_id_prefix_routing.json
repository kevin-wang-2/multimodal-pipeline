{
  "description": "get / cancel 按 job_id 前缀路由回原节点；未知节点 → 503 node_offline；畸形 id → 400",
  "broker": {
    "node_key": "scenario-node-key-0123456789"
  },
  "steps": [
    {
      "register": {
        "type": "register",
        "protocol_version": "2.0",
        "ts": "2026-09-21T00:00:00Z",
        "payload": {
          "node_id": "node-a",
          "node_key": "scenario-node-key-0123456789",
          "capabilities": [
            {
              "id": "echo",
              "tiers": [
                {
                  "tier": "cpu",
                  "engine": "e-echo",
                  "engine_version": "1",
                  "cost": "low"
                }
              ],
              "input": {
                "media": {
                  "presence": "required",
                  "accepts": [
                    "*/*"
                  ]
                }
              },
              "purpose": "diagnostic",
              "output": {
                "schema": {
                  "type": "object"
                },
                "agent_context": "none"
              }
            }
          ],
          "engine_versions": {
            "e-echo": "1"
          }
        }
      },
      "replies": {
        "get": {
          "http_status": 200,
          "body": {
            "job_id": "$echo_job_id",
            "type": "echo",
            "status": "done",
            "media_id": "sha256:6b4a2b8c89e0bcf240920e7922d8d77666f7b61a11ba2ba7389f8156986220f1",
            "cached": false,
            "source": {
              "tier": "cpu",
              "engine": "e-echo",
              "engine_version": "1",
              "generated_at": "2026-09-21T00:00:00Z",
              "degraded": false
            },
            "result": {
              "from": "node-a"
            }
          }
        },
        "cancel": {
          "http_status": 200,
          "body": {
            "job_id": "$echo_job_id",
            "type": "echo",
            "media_id": "sha256:6b4a2b8c89e0bcf240920e7922d8d77666f7b61a11ba2ba7389f8156986220f1",
            "status": "cancelled"
          }
        }
      }
    },
    {
      "register": {
        "type": "register",
        "protocol_version": "2.0",
        "ts": "2026-09-21T00:00:00Z",
        "payload": {
          "node_id": "node-b",
          "node_key": "scenario-node-key-0123456789",
          "capabilities": [
            {
              "id": "echo",
              "tiers": [
                {
                  "tier": "cpu",
                  "engine": "e-echo",
                  "engine_version": "1",
                  "cost": "low"
                }
              ],
              "input": {
                "media": {
                  "presence": "required",
                  "accepts": [
                    "*/*"
                  ]
                }
              },
              "purpose": "diagnostic",
              "output": {
                "schema": {
                  "type": "object"
                },
                "agent_context": "none"
              }
            }
          ],
          "engine_versions": {
            "e-echo": "1"
          }
        }
      },
      "replies": {
        "get": {
          "http_status": 200,
          "body": {
            "job_id": "$echo_job_id",
            "type": "echo",
            "status": "done",
            "media_id": "sha256:6b4a2b8c89e0bcf240920e7922d8d77666f7b61a11ba2ba7389f8156986220f1",
            "cached": false,
            "source": {
              "tier": "cpu",
              "engine": "e-echo",
              "engine_version": "1",
              "generated_at": "2026-09-21T00:00:00Z",
              "degraded": false
            },
            "usage": {
              "served_from": "compute",
              "tier": "cpu",
              "engine": "e-echo",
              "compute_ms": 12,
              "wasted_ms": 0
            },
            "result": {
              "from": "node-b"
            }
          }
        }
      }
    },
    {
      "op": "get",
      "args": {
        "job_id": "node-b-01J7ZQ9K3W8B6Q4M2N1P5R7S9T",
        "wait": 0
      },
      "expect": {
        "http_status": 200,
        "body": {
          "result": {
            "from": "node-b"
          },
          "usage": {
            "served_from": "compute",
            "tier": "cpu",
            "engine": "e-echo",
            "compute_ms": 12,
            "wasted_ms": 0
          }
        }
      },
      "expect_routed_to": "node-b"
    },
    {
      "op": "cancel",
      "args": {
        "job_id": "node-a-01J7ZQ9K3W8B6Q4M2N1P5R7S9T",
        "wait": 0
      },
      "expect": {
        "http_status": 200,
        "body": {
          "status": "cancelled",
          "job_id": "node-a-01J7ZQ9K3W8B6Q4M2N1P5R7S9T"
        }
      },
      "expect_routed_to": "node-a"
    },
    {
      "op": "get",
      "args": {
        "job_id": "ghost-01J7ZQ9K3W8B6Q4M2N1P5R7S9T",
        "wait": 0
      },
      "expect": {
        "http_status": 503,
        "body": {
          "error": "node_offline"
        }
      },
      "expect_routed_to": null
    },
    {
      "op": "get",
      "args": {
        "job_id": "not-a-job-id",
        "wait": 0
      },
      "expect": {
        "http_status": 400,
        "body": {
          "error": "bad_request"
        }
      },
      "expect_routed_to": null
    }
  ]
}
