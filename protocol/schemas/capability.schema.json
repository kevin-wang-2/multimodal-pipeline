{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mmp:protocol:3:capability",
  "title": "Capability",
  "description": "任务类型元数据（架构.md §10）。A 的注册表里每个任务类型一条，绑定 B 接收整表，远端 B 只接收 public 能力；B 的 GET /capabilities 汇总后给 C。预检（triage.*）与能力是同一套任务系统里的不同任务类型。",
  "type": "object",
  "properties": {
    "id": { "$ref": "#/$defs/TaskTypeId" },
    "visibility": {
      "description": "public 能力可发布给远端 B；internal 能力只向 provider 绑定的 B 发布和执行。此字段不判断调用者网络来源。",
      "type": "string",
      "enum": ["public", "internal"]
    },
    "purpose": {
      "description": "稳定的能力意图；客户端用 purpose + Content-Type 发现任务，不依赖任务 id 或封闭模态枚举。",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
      "maxLength": 64
    },
    "description": {
      "description": "给上层 agent 看的一句话说明；agent 按能力名从 /capabilities 按需拉取。",
      "type": "string",
      "maxLength": 500
    },
    "consumes": {
      "description": "该能力适用的媒体特征；预检据此筛出 capabilities_available（M2）。省略表示对该模态的任何媒体都适用。",
      "type": "object",
      "properties": {
        "labels": {
          "description": "适用的粗类别标签（AudioSet 等），任一命中即可。",
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "granularity": {
          "type": "string",
          "enum": ["whole", "segment", "page", "region"]
        }
      },
      "additionalProperties": false
    },
    "tiers": {
      "description": "该任务类型在本节点可用的引擎档位，按偏好排序：第一项是默认档，后面的是回落 / 升级候选。",
      "type": "array",
      "items": { "$ref": "#/$defs/TierSpec" },
      "minItems": 1
    },
    "input": {
      "type": "object",
      "properties": {
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/InputField" },
          "minItems": 1
        }
      },
      "required": ["fields"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/OutputField" },
          "minItems": 1
        },
        "agent_context": {
          "description": "该任务是否生成可直接交给基础模型的通用 agent context。",
          "type": "string",
          "enum": ["required", "optional", "none"]
        }
      },
      "required": ["fields", "agent_context"],
      "additionalProperties": false
    }
  },
  "required": ["id", "visibility", "purpose", "tiers", "input", "output"],
  "additionalProperties": false,
  "$defs": {
    "TaskTypeId": {
      "description": "任务类型 id。点号分命名空间（triage.audio / ocr.structured），下划线分词（pitch_transcribe）。",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
      "maxLength": 64
    },
    "Tier": {
      "description": "引擎档位。cpu 便宜档常开；gpu-fast 快档；gpu 慢档 / 重模型；remote 由 A 转调外部服务。",
      "type": "string",
      "enum": ["cpu", "gpu-fast", "gpu", "remote"]
    },
    "FieldName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "Cardinality": {
      "type": "object",
      "properties": {
        "min": { "type": "integer", "minimum": 0, "default": 0 },
        "max": { "type": "integer", "minimum": 1 }
      },
      "required": ["min", "max"],
      "additionalProperties": false
    },
    "InputField": {
      "oneOf": [
        { "$ref": "#/$defs/TextInputField" },
        { "$ref": "#/$defs/JsonInputField" },
        { "$ref": "#/$defs/MediaInputField" }
      ]
    },
    "TextInputField": {
      "type": "object",
      "properties": {
        "name": { "$ref": "#/$defs/FieldName" }, "kind": { "const": "text" },
        "required": { "type": "boolean" }, "description": { "type": "string", "maxLength": 500 },
        "schema": { "type": "object" }
      },
      "required": ["name", "kind", "required", "schema"],
      "additionalProperties": false
    },
    "JsonInputField": {
      "type": "object",
      "properties": {
        "name": { "$ref": "#/$defs/FieldName" }, "kind": { "const": "json" },
        "required": { "type": "boolean" }, "description": { "type": "string", "maxLength": 500 },
        "schema": { "type": "object" }
      },
      "required": ["name", "kind", "required", "schema"],
      "additionalProperties": false
    },
    "MediaInputField": {
      "type": "object",
      "properties": {
        "name": { "$ref": "#/$defs/FieldName" }, "kind": { "const": "media" },
        "required": { "type": "boolean" }, "description": { "type": "string", "maxLength": 500 },
        "accepts": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(\\*/\\*|[a-z0-9!#$&^_.+-]+/(\\*|[a-z0-9!#$&^_.+-]+))$" },
          "minItems": 1, "uniqueItems": true
        },
        "cardinality": { "$ref": "#/$defs/Cardinality" },
        "preprocessor": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" }
      },
      "required": ["name", "kind", "required", "accepts", "cardinality"],
      "additionalProperties": false
    },
    "OutputField": {
      "oneOf": [
        { "$ref": "#/$defs/TextOutputField" },
        { "$ref": "#/$defs/JsonOutputField" },
        { "$ref": "#/$defs/MediaOutputField" }
      ]
    },
    "TextOutputField": {
      "type": "object",
      "properties": {
        "name": { "$ref": "#/$defs/FieldName" }, "kind": { "const": "text" },
        "required": { "type": "boolean" }, "description": { "type": "string", "maxLength": 500 },
        "schema": { "type": "object" }
      },
      "required": ["name", "kind", "required", "schema"],
      "additionalProperties": false
    },
    "JsonOutputField": {
      "type": "object",
      "properties": {
        "name": { "$ref": "#/$defs/FieldName" }, "kind": { "const": "json" },
        "required": { "type": "boolean" }, "description": { "type": "string", "maxLength": 500 },
        "schema": {
          "oneOf": [
            { "type": "string", "pattern": "^urn:mmp:protocol:3:[a-z0-9-]+(#.*)?$" },
            { "type": "object" }
          ]
        }
      },
      "required": ["name", "kind", "required", "schema"],
      "additionalProperties": false
    },
    "MediaOutputField": {
      "type": "object",
      "properties": {
        "name": { "$ref": "#/$defs/FieldName" }, "kind": { "const": "media" },
        "required": { "type": "boolean" }, "description": { "type": "string", "maxLength": 500 },
        "produces": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9!#$&^_.+-]+/(\\*|[a-z0-9!#$&^_.+-]+)$" },
          "minItems": 1, "uniqueItems": true
        },
        "cardinality": { "$ref": "#/$defs/Cardinality" }
      },
      "required": ["name", "kind", "required", "produces", "cardinality"],
      "additionalProperties": false
    },
    "TierSpec": {
      "type": "object",
      "properties": {
        "tier": { "$ref": "#/$defs/Tier" },
        "engine": {
          "description": "引擎标识，如 silero-vad+sensevoice-int8+zipformer-tagging-int8、pp-ocrv6、paddleocr-vl。",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "engine_version": {
          "description": "进缓存键；升级引擎自动失效旧缓存。",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "cost": { "type": "string", "enum": ["low", "medium", "high"] },
        "latency_hint": {
          "description": "人读的延迟提示，如 \"~2s\"、\"~9s/page\"。",
          "type": "string",
          "maxLength": 64
        },
        "vram_mb": {
          "description": "单任务显存预算（MiB）；调度器据此串行。cpu 档省略。",
          "type": "integer",
          "minimum": 0
        },
        "max_concurrency": {
          "description": "该档位在本节点的并发上限。",
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["tier", "engine", "engine_version", "cost"],
      "additionalProperties": false
    }
  }
}
