{
  "name": "@mmp/openclaw",
  "version": "0.2.0",
  "type": "module",
  "description": "multimodal-pipeline 的 OpenClaw 适配：按附件 MIME 发现 triage 能力并透传任务端 agent context，失败时显式降级。",
  "license": "Apache-2.0",
  "bin": {
    "mmp-triage": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://mmp.seanartech.com/npm/",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kevin-wang-2/multimodal-pipeline",
    "directory": "ts/packages/openclaw"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@mmp/client": "workspace:^"
  },
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.0",
      "minGatewayVersion": "2026.7.0"
    },
    "hostVersion": ">=2026.7.0   (运行在 OpenClaw 进程内；不作为 peerDependency 声明，避免 pnpm 把整个 openclaw 装进工作区)"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
