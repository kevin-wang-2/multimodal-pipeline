{
  "id": "music.generate",
  "visibility": "public",
  "purpose": "music.generate",
  "description": "YuE2 BF16：风格与分段歌词生成 48 kHz 双声道歌曲，可提供或修改 ABC 曲谱后重新生成整曲。检查 metadata.truncated 判断是否达到序列上限。大音频需要 delivery.audio PUT 端点。",
  "tiers": [
    {
      "tier": "gpu",
      "engine": "yue2-bf16-cudnn",
      "engine_version": "1-0.1.6-cudnn-8f24312f-152733a1",
      "cost": "high",
      "vram_mb": 12000,
      "max_concurrency": 1
    }
  ],
  "input": {
    "fields": [
      {
        "name": "style",
        "kind": "text",
        "required": true,
        "description": "音乐风格、语言、乐器、演唱特点与速度",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      {
        "name": "lyrics",
        "kind": "text",
        "required": true,
        "description": "使用 [Verse]、[Chorus] 等曲式标签的歌词",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        }
      },
      {
        "name": "score",
        "kind": "text",
        "required": false,
        "description": "可选 YuE2 原生 ABC 曲谱；可将上一轮返回的 score 修改后作为新输入",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000
        }
      },
      {
        "name": "options",
        "kind": "json",
        "required": false,
        "description": "随机种子；生成配方固定为 BF16、full 乐谱规划与 32 步",
        "schema": {
          "type": "object",
          "properties": {
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295,
              "default": 831001
            }
          },
          "additionalProperties": false
        }
      }
    ]
  },
  "output": {
    "agent_context": "none",
    "fields": [
      {
        "name": "audio",
        "kind": "media",
        "required": true,
        "description": "生成的 48 kHz 双声道 FLAC",
        "produces": [
          "audio/flac"
        ],
        "cardinality": {
          "min": 1,
          "max": 1
        }
      },
      {
        "name": "score",
        "kind": "text",
        "required": true,
        "description": "生成或使用的 ABC 曲谱",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "metadata",
        "kind": "json",
        "required": true,
        "description": "音频信息、随机种子、截断状态与固定执行配方",
        "schema": {
          "type": "object",
          "properties": {
            "sample_rate": {
              "const": 48000
            },
            "channels": {
              "const": 2
            },
            "duration_sec": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            },
            "truncated": {
              "type": "object",
              "properties": {
                "abc": {
                  "type": "boolean"
                },
                "semantic": {
                  "type": "boolean"
                }
              },
              "required": [
                "abc",
                "semantic"
              ],
              "additionalProperties": false
            },
            "attention": {
              "const": "cudnn"
            },
            "ar_execution": {
              "const": "cuda_graph"
            },
            "model_dtype": {
              "const": "bfloat16"
            },
            "vae_dtype": {
              "const": "float32"
            },
            "ode_steps": {
              "const": 32
            },
            "timings_ms": {
              "type": "object"
            }
          },
          "required": [
            "sample_rate",
            "channels",
            "duration_sec",
            "seed",
            "truncated",
            "attention",
            "ar_execution",
            "model_dtype",
            "vae_dtype",
            "ode_steps"
          ],
          "additionalProperties": false
        }
      }
    ]
  }
}
