{
  "id": "triage.audio",
  "description": "音频预检：VAD 定界 + 段级粗类别打标 + 语音段 ASR，产出带时间轴的 digest。",
  "tiers": [
    {
      "tier": "cpu",
      "engine": "silero-vad+sensevoice-int8+zipformer-tagging-int8",
      "engine_version": "m0-2026-09-10",
      "cost": "low",
      "latency_hint": "~0.05× 实时",
      "max_concurrency": 2
    }
  ],
  "input": { "fields": [
    { "name": "media", "kind": "media", "required": true,
      "accepts": ["audio/*", "video/*"], "cardinality": { "min": 1, "max": 1 },
      "preprocessor": "audio.to_wav_16k_mono" },
    { "name": "options", "kind": "json", "required": false, "schema": {
      "type": "object",
      "properties": {
        "label_confidence_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.3
        },
        "language": {
          "type": "string"
        }
      },
      "additionalProperties": false
    } }
  ] },
  "purpose": "triage",
  "output": { "fields": [
    { "name": "digest", "kind": "json", "required": true, "schema": "urn:mmp:protocol:3:digest" }
  ], "agent_context": "required" },
  "visibility": "public"
}
