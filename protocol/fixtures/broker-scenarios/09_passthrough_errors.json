{
  "description": "A 的 4xx / 5xx 原样透传：429 backpressure、422 media_not_found、500 engine_failed",
  "broker": {
    "node_key": "scenario-node-key-0123456789"
  },
  "steps": [
    {
      "register": {
        "type": "register",
        "protocol_version": "1.1",
        "ts": "2026-09-21T00:00:00Z",
        "payload": {
          "node_id": "node-a",
          "node_key": "scenario-node-key-0123456789",
          "capabilities": [
            {
              "id": "echo",
              "modal": "audio",
              "tiers": [
                {
                  "tier": "cpu",
                  "engine": "e-echo",
                  "engine_version": "1",
                  "cost": "low"
                }
              ],
              "input": {
                "media": "required"
              },
              "output_schema": {
                "type": "object"
              }
            }
          ],
          "engine_versions": {
            "e-echo": "1"
          }
        }
      },
      "replies": {
        "submit": {
          "http_status": 429,
          "body": {
            "error": "backpressure",
            "retry_after_sec": 5
          }
        },
        "get": {
          "http_status": 500,
          "body": {
            "job_id": "$echo_job_id",
            "type": "echo",
            "media_id": "sha256:6b4a2b8c89e0bcf240920e7922d8d77666f7b61a11ba2ba7389f8156986220f1",
            "status": "failed",
            "error": "engine_failed",
            "message": "boom"
          }
        }
      }
    },
    {
      "op": "submit",
      "args": {
        "type": "echo",
        "media": {
          "ref": "sha256:6b4a2b8c89e0bcf240920e7922d8d77666f7b61a11ba2ba7389f8156986220f1"
        }
      },
      "expect": {
        "http_status": 429,
        "body": {
          "error": "backpressure",
          "retry_after_sec": 5
        }
      }
    },
    {
      "op": "get",
      "args": {
        "job_id": "node-a-01J7ZQ9K3W8B6Q4M2N1P5R7S9T",
        "wait": 3
      },
      "expect": {
        "http_status": 500,
        "body": {
          "status": "failed",
          "error": "engine_failed",
          "job_id": "node-a-01J7ZQ9K3W8B6Q4M2N1P5R7S9T"
        }
      }
    }
  ]
}
